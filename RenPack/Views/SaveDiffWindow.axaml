<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:RenPack.Views"
        xmlns:controls="using:RenPack.Controls"
        xmlns:vm="using:RenPack.ViewModels"
        xmlns:loc="using:RenPack.Localization"
        x:Class="RenPack.Views.SaveDiffWindow"
        x:DataType="vm:SaveDiffViewModel"
        Width="1080" Height="700" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Tr Diff_Title}"
        Background="{DynamicResource KrosteBackgroundBrush}">
    <DockPanel>
        <controls:TitleBar DockPanel.Dock="Top" Title="{loc:Tr Diff_Title}" />

        <Border DockPanel.Dock="Bottom" Padding="18,10"
                BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="0,1,0,0"
                Background="{DynamicResource KrosteTitleBarBrush}">
            <TextBlock Text="{Binding Summary}" Classes="secondary" VerticalAlignment="Center" />
        </Border>

        <Grid Margin="18" RowDefinitions="Auto,Auto,Auto,*">
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="{loc:Tr Diff_Title}" Classes="h1" />
                <TextBlock Text="{loc:Tr Diff_Subtitle}" Classes="muted" FontSize="12" Margin="0,2,0,0" />
            </StackPanel>

            <Border Grid.Row="1" Classes="card" Padding="12,8" Margin="0,0,0,10">
                <Grid ColumnDefinitions="Auto,*,Auto,*">
                    <TextBlock Grid.Column="0" Text="A:" Classes="muted" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Grid.Column="1" Text="{Binding LeftPath}" Classes="secondary"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="B:" Classes="muted"
                               VerticalAlignment="Center" Margin="18,0,6,0" />
                    <TextBlock Grid.Column="3" Text="{Binding RightPath}" Classes="secondary"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,10">
                <TextBox Grid.Column="0" PlaceholderText="{loc:Tr Diff_Filter_Placeholder}"
                         Text="{Binding FilterText}" />
                <CheckBox Grid.Column="1" Content="{loc:Tr Diff_OnlyDifferences}"
                          IsChecked="{Binding OnlyDifferences}"
                          VerticalAlignment="Center" Foreground="{DynamicResource KrosteSecondaryTextBrush}" />
            </Grid>

            <Border Grid.Row="3" Classes="card-flat" ClipToBounds="True">
                <DataGrid ItemsSource="{Binding Rows}"
                          CanUserSortColumns="True"
                          GridLinesVisibility="Horizontal"
                          Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Δ" Width="40" IsReadOnly="True"
                            Binding="{Binding Marker}" />
                        <DataGridTextColumn Width="2*" IsReadOnly="True"
                            Binding="{Binding Name}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{loc:Tr Save_Column_Name}" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="100" IsReadOnly="True"
                            Binding="{Binding TypeName}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{loc:Tr Save_Column_Type}" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="A" Width="2*" IsReadOnly="True"
                            Binding="{Binding LeftValue}" />
                        <DataGridTextColumn Header="B" Width="2*" IsReadOnly="True"
                            Binding="{Binding RightValue}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </DockPanel>
</views:ChromeWindow>
