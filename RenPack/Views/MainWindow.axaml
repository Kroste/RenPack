<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:RenPack.Views"
        xmlns:controls="using:RenPack.Controls"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:vm="using:RenPack.ViewModels"
        xmlns:loc="using:RenPack.Localization"
        xmlns:conv="using:Avalonia.Data.Converters"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="660"
        x:Class="RenPack.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="960" Height="680" MinWidth="720" MinHeight="480"
        Title="{loc:Tr App_Title}"
        DragDrop.AllowDrop="True"
        Background="{DynamicResource KrosteBackgroundBrush}">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <!-- Tastenkuerzel — Kroste-Standard: Ctrl+O/P Archiv-Aktionen,
         Ctrl+F Filter, F5 Reload, Esc Filter leeren.
         SelectAll/DeselectAll bewusst mit Ctrl+Shift+A/D, damit
         Ctrl+A in Textfeldern (Filter) weiter Text-Selektion macht. -->
    <views:ChromeWindow.KeyBindings>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenArchiveCommand}" />
        <KeyBinding Gesture="Ctrl+P" Command="{Binding CreateArchiveCommand}" />
        <KeyBinding Gesture="F5" Command="{Binding ReloadCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+A" Command="{Binding SelectAllCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+D" Command="{Binding DeselectAllCommand}" />
        <KeyBinding Gesture="Ctrl+E" Command="{Binding ExtractSelectedCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding ClearFilterCommand}" />
    </views:ChromeWindow.KeyBindings>

    <Panel>
    <!-- Basis-Layout unten, Toast-Overlay oben rechts. Panel stapelt
         die beiden ohne sich in den Weg zu kommen. -->
    <DockPanel>
        <controls:TitleBar DockPanel.Dock="Top" Title="{loc:Tr App_Title}">
            <controls:TitleBar.RightContent>
                <Button x:Name="AboutButton" Classes="chrome" Content="ⓘ"
                        ToolTip.Tip="{loc:Tr About_Tip}"
                        chrome:WindowDecorationProperties.ElementRole="User" />
            </controls:TitleBar.RightContent>
        </controls:TitleBar>

        <!-- Statuszeile unten: linker Text + rechts Progress. -->
        <Border DockPanel.Dock="Bottom" Padding="18,10"
                BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="0,1,0,0"
                Background="{DynamicResource KrosteTitleBarBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                           Classes="secondary" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <ProgressBar Grid.Column="1" Width="200" Height="6" VerticalAlignment="Center"
                             Minimum="0" Maximum="1" Value="{Binding Progress}"
                             IsIndeterminate="{Binding ProgressIndeterminate}"
                             IsVisible="{Binding IsBusy}" />
            </Grid>
        </Border>

        <Grid Margin="18" RowDefinitions="Auto,Auto,Auto,Auto,*">

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="{loc:Tr App_Title}" Classes="h1" />
                <TextBlock Text="{loc:Tr Main_Subtitle}"
                           Classes="muted" FontSize="12" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Aktions-Karte -->
            <Border Grid.Row="1" Classes="card" Margin="0,0,0,12">
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto" HorizontalAlignment="Left">
                    <StackPanel Grid.Column="0" Spacing="8">
                        <TextBlock Text="{loc:Tr Section_Archive}" Classes="section-label" />
                        <StackPanel Orientation="Horizontal" Spacing="0">
                            <Button Classes="accent" Content="{loc:Tr Main_OpenArchive}"
                                    Command="{Binding OpenArchiveCommand}"
                                    ToolTip.Tip="{loc:Tr Main_OpenArchive_Tip}"
                                    CornerRadius="6,0,0,6" />
                            <!-- Recent-Dropdown-Button, direkt anschliessend an "Oeffnen". -->
                            <Button Content="▾" Padding="10,7" CornerRadius="0,6,6,0"
                                    ToolTip.Tip="{loc:Tr Main_Recent_Tip}"
                                    IsVisible="{Binding HasRecentArchives}">
                                <Button.Flyout>
                                    <MenuFlyout ItemsSource="{Binding RecentArchives}">
                                        <MenuFlyout.ItemTemplate>
                                            <DataTemplate>
                                                <MenuItem Header="{Binding}"
                                                          Command="{Binding $parent[views:ChromeWindow].DataContext.OpenRecentCommand}"
                                                          CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </MenuFlyout.ItemTemplate>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button Content="{loc:Tr Main_CreateArchive}"
                                    Command="{Binding CreateArchiveCommand}"
                                    ToolTip.Tip="{loc:Tr Main_CreateArchive_Tip}"
                                    Margin="8,0,0,0" />
                            <Button Content="{loc:Tr Main_BatchExtract}"
                                    Command="{Binding BatchExtractCommand}"
                                    ToolTip.Tip="{loc:Tr Main_BatchExtract_Tip}"
                                    Margin="8,0,0,0" />
                            <Button Content="{loc:Tr Main_CompareArchive}"
                                    Command="{Binding CompareArchiveCommand}"
                                    ToolTip.Tip="{loc:Tr Main_CompareArchive_Tip}"
                                    Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Grid.Column="1" Classes="divider-v" Margin="16,4" />

                    <StackPanel Grid.Column="2" Spacing="8">
                        <TextBlock Text="{loc:Tr Section_Tools}" Classes="section-label" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="OpenSaveButton" Content="{loc:Tr Main_OpenSave}"
                                    ToolTip.Tip="{loc:Tr Main_OpenSave_Tip}" />
                            <Button x:Name="DecompileFileButton" Content="{loc:Tr Main_DecompileFile}"
                                    ToolTip.Tip="{loc:Tr Main_DecompileFile_Tip}" />
                            <Button x:Name="ModGeneratorButton" Content="{loc:Tr Main_ModGenerator}"
                                    ToolTip.Tip="{loc:Tr Main_ModGenerator_Tip}" />
                            <StackPanel Orientation="Horizontal" Spacing="0">
                                <Button x:Name="DecompileFolderButton" Content="{loc:Tr Main_DecompileFolder}"
                                        CornerRadius="6,0,0,6"
                                        ToolTip.Tip="{loc:Tr Main_DecompileFolder_Tip}" />
                                <Button Content="▾" Padding="10,7" CornerRadius="0,6,6,0"
                                        ToolTip.Tip="{loc:Tr Main_RecentFolders_Tip}"
                                        IsVisible="{Binding HasRecentDecompileFolders}">
                                    <Button.Flyout>
                                        <MenuFlyout ItemsSource="{Binding RecentDecompileFolders}">
                                            <MenuFlyout.ItemTemplate>
                                                <DataTemplate>
                                                    <MenuItem Header="{Binding}"
                                                              Command="{Binding $parent[views:ChromeWindow].DataContext.OpenRecentDecompileFolderCommand}"
                                                              CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </MenuFlyout.ItemTemplate>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Grid.Column="3" Classes="divider-v" Margin="16,4" />

                    <StackPanel Grid.Column="4" Spacing="8">
                        <TextBlock Text="{loc:Tr Section_Configuration}" Classes="section-label" />
                        <Button x:Name="SettingsButton" Content="{loc:Tr Main_Settings}"
                                ToolTip.Tip="{loc:Tr Main_Settings_Tip}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Extraktions-Aktionen + Archiv-Info -->
            <Border Grid.Row="2" Classes="card" Padding="14,10" Margin="0,0,0,12">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding ArchiveSummary}"
                               Classes="muted" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" FontSize="12" />
                    <TextBlock Grid.Column="1" Text="{Binding SelectedSummary}"
                               Foreground="{DynamicResource KrosteGoldBrush}"
                               VerticalAlignment="Center" Margin="12,0" FontSize="12" />
                    <Button Grid.Column="2" Classes="ghost" Content="{loc:Tr Main_SelectAll}" Padding="10,4"
                            Command="{Binding SelectAllCommand}"
                            ToolTip.Tip="{loc:Tr Main_SelectAll_Tip}" />
                    <Button Grid.Column="3" Classes="ghost" Content="{loc:Tr Main_SelectNone}" Padding="10,4"
                            Command="{Binding DeselectAllCommand}"
                            ToolTip.Tip="{loc:Tr Main_SelectNone_Tip}" />
                    <Rectangle Grid.Column="4" Classes="divider-v" Margin="8,4" />
                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8">
                        <Button Content="{loc:Tr Main_ExtractAll}"
                                Command="{Binding ExtractAllCommand}"
                                ToolTip.Tip="{loc:Tr Main_ExtractAll_Tip}" />
                        <Button Classes="accent" Content="{loc:Tr Main_ExtractSelected}"
                                Command="{Binding ExtractSelectedCommand}"
                                ToolTip.Tip="{loc:Tr Main_ExtractSelected_Tip}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Filter-Zeile — x:Name fuer Ctrl+F-Fokus im Code-behind. -->
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <TextBox Grid.Column="0" x:Name="FilterBox"
                         PlaceholderText="{loc:Tr Main_Filter_Placeholder}"
                         Text="{Binding FilterText}" />
            </Grid>

            <!-- Dateiliste + Preview-Pane, mit GridSplitter zwischen beiden. -->
            <Grid Grid.Row="4" ColumnDefinitions="*,Auto,2*">
                <Border Grid.Column="0" Classes="card-flat" ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding Entries}"
                              SelectedItem="{Binding HighlightedEntry, Mode=TwoWay}"
                              IsReadOnly="False"
                              CanUserReorderColumns="True"
                              CanUserSortColumns="True"
                              GridLinesVisibility="Horizontal"
                              Background="Transparent"
                              DoubleTapped="OnEntryDoubleTapped">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{loc:Tr Ctx_Extract}"
                                          Command="{Binding ExtractHighlightedCommand}" />
                                <MenuItem Header="{loc:Tr Ctx_CopyPath}"
                                          Command="{Binding CopyHighlightedPathCommand}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="✓" Width="42"
                                Binding="{Binding IsSelected}" />
                            <DataGridTextColumn Width="*" IsReadOnly="True"
                                Binding="{Binding Path}">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{loc:Tr Main_Column_File}" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="120" IsReadOnly="True"
                                Binding="{Binding SizeDisplay}">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{loc:Tr Main_Column_Size}" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <GridSplitter Grid.Column="1" Width="6" Background="Transparent"
                              ResizeDirection="Columns" HorizontalAlignment="Center" />

                <!-- Preview-Panel -->
                <Border Grid.Column="2" Classes="card-flat" ClipToBounds="True">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="12,10"
                                BorderBrush="{DynamicResource KrosteBorderBrush}"
                                BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="{loc:Tr Preview_Title}" Classes="section-label" />
                                <TextBlock Text="{Binding Preview.Headline}" Classes="secondary"
                                           FontSize="12" TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding Preview.HasContent}" />
                            </StackPanel>
                        </Border>

                        <!-- Kein Eintrag ausgewaehlt -->
                        <TextBlock Text="{loc:Tr Preview_None}" Classes="muted"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding !Preview.HasContent}" />

                        <!-- Placeholder (unbekanntes Format / zu gross / Fehler) -->
                        <TextBlock Text="{Binding Preview.Placeholder}" Classes="secondary"
                                   Padding="16" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding Preview.IsPlaceholder}" />

                        <!-- Bild-Preview: kleine Bilder Originalgroesse zentriert,
                             grosse Bilder proportional in den Pane einpassen
                             (Uniform + DownOnly). Ohne ScrollViewer — dank
                             DownOnly gibt's nie Overflow. -->
                        <Image IsVisible="{Binding Preview.IsImage}"
                               Source="{Binding Preview.ImageContent}"
                               Stretch="Uniform" StretchDirection="DownOnly"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="12" />

                        <!-- Video/Audio-Preview: Standbild (ffmpeg-Frame-Grab)
                             fuer Video wird direkt ueber die Image-Preview
                             oben gezeigt (IsImage=true). Wenn ffmpeg fehlt
                             oder das Frame nicht klappt, kommt ein grosses
                             Emoji-Icon als Fallback. Playback laeuft ueber
                             den System-Default-Player (VLC/mpv/QuickTime)
                             via Process.Start(useShellExecute) — kein
                             LibVLC-Deployment-Kram. -->
                        <Grid IsVisible="{Binding Preview.IsMedia}" RowDefinitions="*,Auto">
                            <!-- Icon nur zeigen wenn KEIN Standbild da ist:
                                 🎵 fuer Audio, 🎬 fuer Video ohne Frame. -->
                            <TextBlock Grid.Row="0" IsVisible="{Binding !Preview.IsImage}"
                                       Text="🎬" FontSize="96"
                                       Foreground="{DynamicResource KrosteGoldBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" IsVisible="{Binding Preview.IsAudioOnly}"
                                       Text="🎵" FontSize="96"
                                       Foreground="{DynamicResource KrosteGoldBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <!-- Video ohne ffmpeg: kurzer Install-Hinweis unter
                                 dem 🎬-Icon. Wird nicht bei Audio-Only gezeigt
                                 (dort ist ffmpeg irrelevant). -->
                            <TextBlock Grid.Row="0" Text="{loc:Tr Preview_FfmpegMissing}"
                                       Classes="secondary"
                                       Padding="24,140,24,0" TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       MaxWidth="480">
                                <TextBlock.IsVisible>
                                    <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                                        <Binding Path="!Preview.IsAudioOnly" />
                                        <Binding Path="!Preview.CanInlinePlay" />
                                    </MultiBinding>
                                </TextBlock.IsVisible>
                            </TextBlock>
                            <StackPanel Grid.Row="1" Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,10,0,12" Spacing="8">
                                <!-- Inline-Playback (ffmpeg-Frame-Stream, ~12fps,
                                     kein Audio). Nur fuer Video, nicht Audio-only.
                                     Play/Pause-Toggle per zwei Buttons statt Content-
                                     Converter. -->
                                <!-- CanInlinePlay = Video UND ffmpeg installiert.
                                     Ohne ffmpeg macht Inline keinen Sinn und
                                     wuerde beim Klick krachen. -->
                                <Button Content="{loc:Tr Preview_PlayInline}"
                                        Command="{Binding Preview.ToggleInlinePlaybackCommand}"
                                        ToolTip.Tip="{loc:Tr Preview_PlayInline_Tip}">
                                    <Button.IsVisible>
                                        <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                                            <Binding Path="Preview.CanInlinePlay" />
                                            <Binding Path="!Preview.IsPlayingInline" />
                                        </MultiBinding>
                                    </Button.IsVisible>
                                </Button>
                                <Button IsVisible="{Binding Preview.IsPlayingInline}"
                                        Content="{loc:Tr Preview_PauseInline}"
                                        Command="{Binding Preview.ToggleInlinePlaybackCommand}"
                                        ToolTip.Tip="{loc:Tr Preview_PauseInline_Tip}" />
                                <Button Classes="accent"
                                        Content="{loc:Tr Preview_PlayExternal}"
                                        Command="{Binding Preview.PlayExternalCommand}"
                                        ToolTip.Tip="{loc:Tr Preview_PlayExternal_Tip}" />
                            </StackPanel>
                        </Grid>

                        <!-- Text-Preview: monospaced, scrollbar. -->
                        <ScrollViewer IsVisible="{Binding Preview.IsText}"
                                      HorizontalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding Preview.TextContent, Mode=OneWay}"
                                     IsReadOnly="True"
                                     FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace"
                                     FontSize="12"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="12"
                                     TextWrapping="NoWrap"
                                     AcceptsReturn="True" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>

    <!-- Update-Toast: kleine Card oben rechts, klick oeffnet About. -->
    <Border IsVisible="{Binding HasUpdateToast}"
            HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,52,18,0"
            Background="{DynamicResource KrosteAccentBrush}"
            CornerRadius="6" Padding="14,10"
            BoxShadow="0 4 12 0 #66000000">
        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{Binding UpdateToast}" Foreground="#F5F7FA"
                       VerticalAlignment="Center" />
            <Button Content="ⓘ" Padding="6,2" Background="Transparent"
                    BorderThickness="0" Foreground="#F5F7FA"
                    x:Name="ToastAboutButton" ToolTip.Tip="{loc:Tr About_Tip}" />
            <Button Content="✕" Padding="6,2" Background="Transparent"
                    BorderThickness="0" Foreground="#F5F7FA"
                    Command="{Binding DismissUpdateToastCommand}" />
        </StackPanel>
    </Border>
    </Panel>
</views:ChromeWindow>
