<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:RenPack.Views"
        xmlns:controls="using:RenPack.Controls"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:vm="using:RenPack.ViewModels"
        xmlns:loc="using:RenPack.Localization"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="660"
        x:Class="RenPack.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="960" Height="680" MinWidth="720" MinHeight="480"
        Title="{loc:Tr App_Title}"
        DragDrop.AllowDrop="True"
        Background="{DynamicResource KrosteBackgroundBrush}">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <DockPanel>
        <controls:TitleBar DockPanel.Dock="Top" Title="{loc:Tr App_Title}">
            <controls:TitleBar.RightContent>
                <Button x:Name="AboutButton" Classes="chrome" Content="ⓘ"
                        ToolTip.Tip="{loc:Tr About_Tip}"
                        chrome:WindowDecorationProperties.ElementRole="User" />
            </controls:TitleBar.RightContent>
        </controls:TitleBar>

        <!-- Statuszeile unten: linker Text + rechts Progress. -->
        <Border DockPanel.Dock="Bottom" Padding="18,10"
                BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="0,1,0,0"
                Background="{DynamicResource KrosteTitleBarBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                           Classes="secondary" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <ProgressBar Grid.Column="1" Width="200" Height="6" VerticalAlignment="Center"
                             Minimum="0" Maximum="1" Value="{Binding Progress}"
                             IsIndeterminate="{Binding ProgressIndeterminate}"
                             IsVisible="{Binding IsBusy}" />
            </Grid>
        </Border>

        <Grid Margin="18" RowDefinitions="Auto,Auto,Auto,Auto,*">

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="{loc:Tr App_Title}" Classes="h1" />
                <TextBlock Text="{loc:Tr Main_Subtitle}"
                           Classes="muted" FontSize="12" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Aktions-Karte -->
            <Border Grid.Row="1" Classes="card" Margin="0,0,0,12">
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto" HorizontalAlignment="Left">
                    <StackPanel Grid.Column="0" Spacing="8">
                        <TextBlock Text="{loc:Tr Section_Archive}" Classes="section-label" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="accent" Content="{loc:Tr Main_OpenArchive}"
                                    Command="{Binding OpenArchiveCommand}"
                                    ToolTip.Tip="{loc:Tr Main_OpenArchive_Tip}" />
                            <Button Content="{loc:Tr Main_CreateArchive}"
                                    Command="{Binding CreateArchiveCommand}"
                                    ToolTip.Tip="{loc:Tr Main_CreateArchive_Tip}" />
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Grid.Column="1" Classes="divider-v" Margin="16,4" />

                    <StackPanel Grid.Column="2" Spacing="8">
                        <TextBlock Text="{loc:Tr Section_Tools}" Classes="section-label" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="OpenSaveButton" Content="{loc:Tr Main_OpenSave}"
                                    ToolTip.Tip="{loc:Tr Main_OpenSave_Tip}" />
                            <Button x:Name="DecompileFileButton" Content="{loc:Tr Main_DecompileFile}"
                                    ToolTip.Tip="{loc:Tr Main_DecompileFile_Tip}" />
                            <Button x:Name="DecompileFolderButton" Content="{loc:Tr Main_DecompileFolder}"
                                    ToolTip.Tip="{loc:Tr Main_DecompileFolder_Tip}" />
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Grid.Column="3" Classes="divider-v" Margin="16,4" />

                    <StackPanel Grid.Column="4" Spacing="8">
                        <TextBlock Text="{loc:Tr Section_Configuration}" Classes="section-label" />
                        <Button x:Name="SettingsButton" Content="{loc:Tr Main_Settings}"
                                ToolTip.Tip="{loc:Tr Main_Settings_Tip}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Extraktions-Aktionen + Archiv-Info -->
            <Border Grid.Row="2" Classes="card" Padding="14,10" Margin="0,0,0,12">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding ArchiveSummary}"
                               Classes="muted" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" FontSize="12" />
                    <TextBlock Grid.Column="1" Text="{Binding SelectedSummary}"
                               Foreground="{DynamicResource KrosteGoldBrush}"
                               VerticalAlignment="Center" Margin="12,0" FontSize="12" />
                    <Button Grid.Column="2" Classes="ghost" Content="{loc:Tr Main_SelectAll}" Padding="10,4"
                            Command="{Binding SelectAllCommand}"
                            ToolTip.Tip="{loc:Tr Main_SelectAll_Tip}" />
                    <Button Grid.Column="3" Classes="ghost" Content="{loc:Tr Main_SelectNone}" Padding="10,4"
                            Command="{Binding DeselectAllCommand}"
                            ToolTip.Tip="{loc:Tr Main_SelectNone_Tip}" />
                    <Rectangle Grid.Column="4" Classes="divider-v" Margin="8,4" />
                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8">
                        <Button Content="{loc:Tr Main_ExtractAll}"
                                Command="{Binding ExtractAllCommand}"
                                ToolTip.Tip="{loc:Tr Main_ExtractAll_Tip}" />
                        <Button Classes="accent" Content="{loc:Tr Main_ExtractSelected}"
                                Command="{Binding ExtractSelectedCommand}"
                                ToolTip.Tip="{loc:Tr Main_ExtractSelected_Tip}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Filter-Zeile -->
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <TextBox Grid.Column="0" PlaceholderText="{loc:Tr Main_Filter_Placeholder}"
                         Text="{Binding FilterText}" />
            </Grid>

            <!-- Dateiliste als Card -->
            <Border Grid.Row="4" Classes="card-flat" ClipToBounds="True">
                <DataGrid ItemsSource="{Binding Entries}"
                          IsReadOnly="False"
                          CanUserReorderColumns="True"
                          CanUserSortColumns="True"
                          GridLinesVisibility="Horizontal"
                          Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="✓" Width="42"
                            Binding="{Binding IsSelected}" />
                        <DataGridTextColumn Width="*" IsReadOnly="True"
                            Binding="{Binding Path}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{loc:Tr Main_Column_File}" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="120" IsReadOnly="True"
                            Binding="{Binding SizeDisplay}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{loc:Tr Main_Column_Size}" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </DockPanel>
</views:ChromeWindow>
