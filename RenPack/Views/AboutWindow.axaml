<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:RenPack.Views"
        xmlns:controls="using:RenPack.Controls"
        x:Class="RenPack.Views.AboutWindow"
        Width="420" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Über RenPack"
        Background="{DynamicResource KrosteBackgroundBrush}">
    <DockPanel>
        <controls:TitleBar DockPanel.Dock="Top" Title="Über RenPack" />
        <StackPanel Margin="24" Spacing="14">
            <TextBlock Text="RenPack" FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource KrosteGoldBrush}" />
            <TextBlock Text="Ren'Py-Archive (.rpa) entpacken und packen"
                       Foreground="#C5CBD3" TextWrapping="Wrap" />
            <TextBlock x:Name="VersionText" Foreground="#8A93A0" />

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="UpdateButton" Classes="accent" Content="Auf Updates prüfen" />
                <TextBlock x:Name="UpdateResult" VerticalAlignment="Center" Foreground="#B7BEC7" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="GithubButton" Content="GitHub" />
                <Button x:Name="BmcButton" Content="☕ Buy me a coffee" />
            </StackPanel>

            <TextBlock Text="MIT-Lizenz · © 2026 Lars Krügel (Kroste)"
                       Foreground="#6B7280" FontSize="11" />
        </StackPanel>
    </DockPanel>
</views:ChromeWindow>
