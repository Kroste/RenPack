<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:RenPack.Views"
        xmlns:controls="using:RenPack.Controls"
        xmlns:loc="using:RenPack.Localization"
        x:Class="RenPack.Views.AboutWindow"
        Width="420" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Tr Window_About}"
        Background="{DynamicResource KrosteBackgroundBrush}">
    <DockPanel>
        <controls:TitleBar DockPanel.Dock="Top" Title="{loc:Tr Window_About}" />
        <StackPanel Margin="24" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Tr App_Title}" Classes="h1" FontSize="22" />
                <TextBlock Text="{loc:Tr About_Subtitle}"
                           Classes="secondary" TextWrapping="Wrap" />
                <TextBlock x:Name="VersionText" Classes="muted" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>

            <Rectangle Classes="divider-h" />

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="UpdateButton" Classes="accent" Content="{loc:Tr About_CheckUpdates}" />
                <TextBlock x:Name="UpdateResult" VerticalAlignment="Center" Classes="secondary" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="GithubButton" Content="{loc:Tr About_GitHub}" />
                <Button x:Name="BmcButton" Content="{loc:Tr About_BuyMeCoffee}" />
            </StackPanel>

            <TextBlock Text="{loc:Tr About_License}"
                       Foreground="#6B7280" FontSize="11" />
        </StackPanel>
    </DockPanel>
</views:ChromeWindow>
