<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:RenPack.Views"
        xmlns:controls="using:RenPack.Controls"
        xmlns:vm="using:RenPack.ViewModels"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="620"
        x:Class="RenPack.Views.SaveWindow"
        x:DataType="vm:SaveWindowViewModel"
        Width="900" Height="640" MinWidth="640" MinHeight="440"
        Title="RenPack — Save-Editor"
        WindowStartupLocation="CenterOwner"
        DragDrop.AllowDrop="True"
        Background="{DynamicResource KrosteBackgroundBrush}">

    <Design.DataContext>
        <vm:SaveWindowViewModel />
    </Design.DataContext>

    <DockPanel>
        <controls:TitleBar DockPanel.Dock="Top" Title="RenPack — Save-Editor" />

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource KrosteTitleBarBrush}" Padding="12,8">
            <WrapPanel Orientation="Horizontal">
                <Button Classes="accent" Content="💾 Save öffnen" Margin="0,0,8,0"
                        Command="{Binding OpenSaveCommand}" />
                <Rectangle Width="1" Margin="4,2" Fill="#33FFFFFF" />
                <Button Content="💾 Speichern" Margin="8,0,8,0"
                        Command="{Binding SaveCommand}" />
                <Button Content="💾 Speichern unter …" Margin="0,0,8,0"
                        Command="{Binding SaveAsCommand}" />
                <Button Content="↩ Verwerfen" Margin="0,0,8,0"
                        Command="{Binding RevertCommand}" />
                <Rectangle Width="1" Margin="4,2" Fill="#33FFFFFF" />
                <Button Content="🌐 Übersetzen" Margin="8,0,8,0"
                        Command="{Binding TranslateCommand}"
                        ToolTip.Tip="Variablennamen per KI in die Zielsprache übersetzen (Einstellungen prüfen)" />
                <TextBlock Text="{Binding DirtySummary}" Margin="12,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource KrosteGoldBrush}" />
                <CheckBox Content="_interne (mit _)" Margin="24,0,0,0"
                          IsChecked="{Binding ShowInternal}"
                          VerticalAlignment="Center" Foreground="#B7BEC7" />
            </WrapPanel>
        </Border>

        <!-- Statuszeile -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource KrosteTitleBarBrush}" Padding="12,6">
            <TextBlock Text="{Binding StatusText}" Foreground="#B7BEC7"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- Fehler-Banner -->
        <Border DockPanel.Dock="Top" Background="#3A2020" Padding="12,8"
                IsVisible="{Binding HasLogError}">
            <TextBlock Foreground="#FFD1D1" TextWrapping="Wrap"
                       Text="{Binding LogErrorText, StringFormat='⚠ Log konnte nicht dekodiert werden: {0}. Metadaten und Screenshot sind trotzdem verfügbar; Editieren nicht möglich.'}" />
        </Border>

        <!-- Kopfzeile -->
        <Border DockPanel.Dock="Top" Padding="12,10,12,4">
            <TextBlock Text="{Binding SaveSummary}" Foreground="{DynamicResource KrosteGoldBrush}"
                       FontSize="13" TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- Filter -->
        <Border DockPanel.Dock="Top" Padding="12,4,12,8" IsVisible="{Binding HasSave}">
            <TextBox PlaceholderText="Variablen filtern nach Name …"
                     Text="{Binding FilterText}" />
        </Border>

        <!-- Hauptbereich: Screenshot links, editierbare Variablen rechts -->
        <Grid Margin="12,0,12,12" ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" Width="280" MinHeight="180" Margin="0,0,12,0"
                    CornerRadius="6" ClipToBounds="True"
                    Background="{DynamicResource KrosteSurfaceBrush}"
                    IsVisible="{Binding HasScreenshot}">
                <Image Source="{Binding Screenshot}" Stretch="Uniform"
                       VerticalAlignment="Top" />
            </Border>

            <Border Grid.Column="1" CornerRadius="6" ClipToBounds="True"
                    Background="{DynamicResource KrosteSurfaceBrush}">
                <DataGrid ItemsSource="{Binding Variables}"
                          CanUserReorderColumns="True"
                          CanUserSortColumns="True"
                          GridLinesVisibility="Horizontal"
                          Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Width="*" IsReadOnly="True"
                            Binding="{Binding Name}" />
                        <DataGridTextColumn Header="Beschreibung" Width="*" IsReadOnly="True"
                            Binding="{Binding Description}" />
                        <DataGridTextColumn Header="Typ" Width="110" IsReadOnly="True"
                            Binding="{Binding TypeName}" />
                        <!-- Wert-Spalte: editierbar, wenn IsEditable=true.
                             Ein visueller Marker "*" wird bei Dirty gezeigt. -->
                        <DataGridTemplateColumn Header="Wert" Width="2*" CanUserSort="True"
                                                SortMemberPath="EditableValue">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="vm:SaveVariableViewModel">
                                    <Grid ColumnDefinitions="*,Auto" Margin="4,0">
                                        <TextBlock Grid.Column="0" Text="{Binding EditableValue}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="●" Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource KrosteGoldBrush}"
                                                   IsVisible="{Binding IsDirty}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate DataType="vm:SaveVariableViewModel">
                                    <TextBox Text="{Binding EditableValue, Mode=TwoWay}"
                                             IsEnabled="{Binding IsEditable}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </DockPanel>
</views:ChromeWindow>
