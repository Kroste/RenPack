<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:RenPack.Views"
        xmlns:controls="using:RenPack.Controls"
        xmlns:vm="using:RenPack.ViewModels"
        xmlns:loc="using:RenPack.Localization"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="680"
        x:Class="RenPack.Views.SaveWindow"
        x:DataType="vm:SaveWindowViewModel"
        Width="960" Height="700" MinWidth="720" MinHeight="500"
        Title="{loc:Tr Window_SaveEditor}"
        WindowStartupLocation="CenterOwner"
        DragDrop.AllowDrop="True"
        Background="{DynamicResource KrosteBackgroundBrush}">

    <Design.DataContext>
        <vm:SaveWindowViewModel />
    </Design.DataContext>

    <views:ChromeWindow.KeyBindings>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenSaveCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
    </views:ChromeWindow.KeyBindings>

    <DockPanel>
        <controls:TitleBar DockPanel.Dock="Top" Title="{loc:Tr Window_SaveEditor}" />

        <Border DockPanel.Dock="Bottom" Padding="18,10"
                BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="0,1,0,0"
                Background="{DynamicResource KrosteTitleBarBrush}">
            <TextBlock Text="{Binding StatusText}" Classes="secondary"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Border>

        <Border DockPanel.Dock="Top" Background="#3A2020" Padding="18,10"
                BorderBrush="#5A3030" BorderThickness="0,0,0,1"
                IsVisible="{Binding HasLogError}">
            <TextBlock Foreground="#FFD1D1" TextWrapping="Wrap"
                       Text="{Binding LogErrorText}" />
        </Border>

        <Grid Margin="18" RowDefinitions="Auto,Auto,Auto,Auto,*">

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="{loc:Tr Window_SaveEditor}" Classes="h1" />
                <TextBlock Text="{loc:Tr Save_Subtitle}"
                           Classes="muted" FontSize="12" Margin="0,2,0,0" />
            </StackPanel>

            <Border Grid.Row="1" Classes="card" Margin="0,0,0,12">
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*">
                    <StackPanel Grid.Column="0" Spacing="8">
                        <TextBlock Text="{loc:Tr Save_Section_File}" Classes="section-label" />
                        <Button Classes="accent" Content="{loc:Tr Save_Open}"
                                Command="{Binding OpenSaveCommand}"
                                ToolTip.Tip="{loc:Tr Save_Open_Tip}" />
                    </StackPanel>

                    <Rectangle Grid.Column="1" Classes="divider-v" Margin="16,4" />

                    <StackPanel Grid.Column="2" Spacing="8">
                        <TextBlock Text="{loc:Tr Save_Section_Changes}" Classes="section-label" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="ghost" Content="↶" Padding="10,4"
                                    Command="{Binding UndoCommand}"
                                    ToolTip.Tip="{loc:Tr Save_Undo_Tip}" />
                            <Button Classes="ghost" Content="↷" Padding="10,4"
                                    Command="{Binding RedoCommand}"
                                    ToolTip.Tip="{loc:Tr Save_Redo_Tip}" />
                            <Button Content="{loc:Tr Save_Save}"
                                    Command="{Binding SaveCommand}"
                                    ToolTip.Tip="{loc:Tr Save_Save_Tip}" />
                            <Button Content="{loc:Tr Save_SaveAs}"
                                    Command="{Binding SaveAsCommand}"
                                    ToolTip.Tip="{loc:Tr Save_SaveAs_Tip}" />
                            <Button Classes="danger" Content="{loc:Tr Save_Revert}"
                                    Command="{Binding RevertCommand}"
                                    ToolTip.Tip="{loc:Tr Save_Revert_Tip}" />
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Grid.Column="3" Classes="divider-v" Margin="16,4" />

                    <StackPanel Grid.Column="4" Spacing="8">
                        <TextBlock Text="{loc:Tr Save_Section_Ai}" Classes="section-label" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{loc:Tr Save_Translate}"
                                    Command="{Binding TranslateCommand}"
                                    ToolTip.Tip="{loc:Tr Save_Translate_Tip}" />
                            <Button Content="{loc:Tr Save_Compare}"
                                    Command="{Binding CompareCommand}"
                                    ToolTip.Tip="{loc:Tr Save_Compare_Tip}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="5" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Spacing="12">
                        <TextBlock Text="{Binding DirtySummary}"
                                   Foreground="{DynamicResource KrosteGoldBrush}"
                                   VerticalAlignment="Center" />
                        <CheckBox Content="{loc:Tr Save_ShowInternal}"
                                  IsChecked="{Binding ShowInternal}"
                                  VerticalAlignment="Center" Foreground="{DynamicResource KrosteSecondaryTextBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Classes="card" Padding="14,10" Margin="0,0,0,12"
                    IsVisible="{Binding HasSave}">
                <TextBlock Text="{Binding SaveSummary}" Foreground="{DynamicResource KrosteGoldBrush}"
                           FontSize="12" TextTrimming="CharacterEllipsis" />
            </Border>

            <TextBox Grid.Row="3" Margin="0,0,0,12"
                     PlaceholderText="{loc:Tr Save_Filter_Placeholder}"
                     Text="{Binding FilterText}"
                     IsVisible="{Binding HasSave}" />

            <Grid Grid.Row="4" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border Grid.Column="0" Classes="card-flat" Width="280" MinHeight="180"
                        ClipToBounds="True" VerticalAlignment="Top"
                        IsVisible="{Binding HasScreenshot}">
                    <Image Source="{Binding Screenshot}" Stretch="Uniform"
                           VerticalAlignment="Top" />
                </Border>

                <Border Grid.Column="1" Classes="card-flat" ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding Variables}"
                              CanUserReorderColumns="True"
                              CanUserSortColumns="True"
                              GridLinesVisibility="Horizontal"
                              Background="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*" IsReadOnly="True"
                                Binding="{Binding Name}">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{loc:Tr Save_Column_Name}" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="*" IsReadOnly="True"
                                Binding="{Binding Description}">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{loc:Tr Save_Column_Description}" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="110" IsReadOnly="True"
                                Binding="{Binding TypeName}">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{loc:Tr Save_Column_Type}" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Width="2*" CanUserSort="True"
                                                    SortMemberPath="EditableValue">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="{loc:Tr Save_Column_Value}" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="vm:SaveVariableViewModel">
                                        <Grid ColumnDefinitions="*,Auto" Margin="4,0">
                                            <TextBlock Grid.Column="0" Text="{Binding EditableValue}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="●" Margin="6,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource KrosteGoldBrush}"
                                                       IsVisible="{Binding IsDirty}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate DataType="vm:SaveVariableViewModel">
                                        <TextBox Text="{Binding EditableValue, Mode=TwoWay}"
                                                 IsEnabled="{Binding IsEditable}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</views:ChromeWindow>
