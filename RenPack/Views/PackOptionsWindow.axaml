<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:RenPack.Views"
        xmlns:controls="using:RenPack.Controls"
        xmlns:vm="using:RenPack.ViewModels"
        xmlns:loc="using:RenPack.Localization"
        x:Class="RenPack.Views.PackOptionsWindow"
        x:DataType="vm:PackOptionsViewModel"
        Width="440" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Tr Pack_Title}"
        Background="{DynamicResource KrosteBackgroundBrush}">
    <DockPanel>
        <controls:TitleBar DockPanel.Dock="Top" Title="{loc:Tr Pack_Title}" />

        <Border DockPanel.Dock="Bottom" Padding="18,12"
                BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="0,1,0,0"
                Background="{DynamicResource KrosteTitleBarBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="{loc:Tr Settings_Cancel}" Command="{Binding CancelCommand}" />
                <Button Classes="accent" Content="{loc:Tr Common_Ok}" Command="{Binding OkCommand}" IsDefault="True" />
            </StackPanel>
        </Border>

        <StackPanel Margin="24" Spacing="14">
            <TextBlock Text="{loc:Tr Pack_Subtitle}" Classes="muted" TextWrapping="Wrap" />

            <StackPanel Spacing="6">
                <TextBlock Text="{loc:Tr Pack_Format}" Classes="secondary" />
                <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}"
                          HorizontalAlignment="Stretch" />
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding NeedsKey}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{loc:Tr Pack_Key}" Classes="secondary"
                               VerticalAlignment="Bottom" />
                    <Button Grid.Column="1" Classes="ghost" Content="{loc:Tr Pack_KeyReset}" Padding="10,4"
                            Command="{Binding ResetKeyCommand}" />
                </Grid>
                <TextBox Text="{Binding KeyHex}" FontFamily="Cascadia Mono,Consolas,monospace"
                         PlaceholderText="deadbeef" />
                <TextBlock Text="{Binding KeyError}" Foreground="{DynamicResource KrosteDangerBrush}"
                           FontSize="11" IsVisible="{Binding KeyError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{loc:Tr Pack_KeyHint}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</views:ChromeWindow>
