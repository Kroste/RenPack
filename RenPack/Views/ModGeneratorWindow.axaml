<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:RenPack.Views"
        xmlns:controls="using:RenPack.Controls"
        xmlns:vm="using:RenPack.ViewModels"
        xmlns:loc="using:RenPack.Localization"
        mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="620"
        x:Class="RenPack.Views.ModGeneratorWindow"
        x:DataType="vm:ModGeneratorViewModel"
        Width="720" Height="620" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Tr Window_ModGenerator}"
        Background="{DynamicResource KrosteBackgroundBrush}">

    <Design.DataContext>
        <vm:ModGeneratorViewModel />
    </Design.DataContext>

    <DockPanel>
        <controls:TitleBar DockPanel.Dock="Top" Title="{loc:Tr Window_ModGenerator}" />

        <!-- Statusbar -->
        <Border DockPanel.Dock="Bottom" Padding="18,10"
                BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="0,1,0,0"
                Background="{DynamicResource KrosteTitleBarBrush}">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding StatusText}" Classes="secondary"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ProgressDetail}" Classes="muted"
                           FontFamily="Cascadia Mono,Consolas,monospace"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <ScrollViewer>
            <StackPanel Margin="24" Spacing="16">

                <!-- Header -->
                <StackPanel>
                    <TextBlock Text="{loc:Tr Window_ModGenerator}" Classes="h1" />
                    <TextBlock Text="{loc:Tr Mod_Subtitle}" Classes="muted" FontSize="12"
                               Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Karte 1: Spiel-Ordner -->
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{loc:Tr Mod_Section_Game}" Classes="section-label" />
                        <TextBlock Text="{loc:Tr Mod_Game_Description}" Classes="muted"
                                   FontSize="11" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0" Text="{Binding GameFolder}"
                                     PlaceholderText="{loc:Tr Mod_Game_Placeholder}"
                                     IsEnabled="{Binding !IsBusy}" />
                            <Button Grid.Column="1" Content="{loc:Tr Mod_Pick}"
                                    Command="{Binding PickFolderCommand}" />
                        </Grid>
                        <!-- Auflösung des game/-Ordners anzeigen wenn abweichend -->
                        <TextBlock FontSize="11" Classes="muted"
                                   IsVisible="{Binding ResolvedGameDir, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   TextWrapping="Wrap">
                            <Run Text="{loc:Tr Mod_Resolved_Prefix}" />
                            <Run Text="{Binding ResolvedGameDir}"
                                 FontFamily="Cascadia Mono,Consolas,monospace"
                                 Foreground="{DynamicResource KrosteGoldBrush}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Karte 2: Mod-Typ + Start -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{loc:Tr Mod_Section_Build}" Classes="section-label" />

                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Tr Mod_Type}" Classes="secondary" />
                            <ComboBox ItemsSource="{Binding AvailableModTypes}"
                                      SelectedItem="{Binding SelectedModType}"
                                      HorizontalAlignment="Stretch"
                                      IsEnabled="{Binding !IsBusy}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Classes="accent" Content="{loc:Tr Mod_BuildAction}"
                                    Command="{Binding BuildCommand}"
                                    Padding="18,10" FontSize="14" />
                            <Button Classes="danger" Content="{loc:Tr Mod_UninstallAction}"
                                    Command="{Binding UninstallCommand}"
                                    IsVisible="{Binding HasInstalledMod}"
                                    Padding="18,10" FontSize="14" />
                            <ProgressBar IsIndeterminate="True"
                                         IsVisible="{Binding IsBusy}"
                                         Width="160" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="{loc:Tr Mod_Hint_Backup}" Classes="muted"
                                   FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Karte 3: Ergebnis-Statistik (nur nach erfolgreichem Build) -->
                <Border Classes="card" IsVisible="{Binding HasResult}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{loc:Tr Mod_Section_Result}" Classes="section-label" />
                        <UniformGrid Columns="2" Rows="1">
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding ResultFilesText}" Classes="h2" HorizontalAlignment="Center" />
                                <TextBlock Text="{loc:Tr Mod_Result_Files}" Classes="muted" FontSize="11" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding ResultChoicesText}" Classes="h2" HorizontalAlignment="Center" />
                                <TextBlock Text="{loc:Tr Mod_Result_Choices}" Classes="muted" FontSize="11" HorizontalAlignment="Center" />
                            </StackPanel>
                        </UniformGrid>
                        <Rectangle Classes="divider-h" Margin="0,6,0,0" />
                        <TextBlock TextWrapping="Wrap" FontSize="11">
                            <Run Text="{loc:Tr Mod_Result_DeployedTo}" Classes="secondary" />
                            <Run Text="{Binding ResultDirText}"
                                 FontFamily="Cascadia Mono,Consolas,monospace"
                                 Foreground="{DynamicResource KrosteGoldBrush}" />
                        </TextBlock>
                        <!-- Pack D v0.9: Spiel-Launcher-Button. Findet .sh/.exe/.py
                             im Spiel-Root und startet via UseShellExecute. Nur
                             sichtbar wenn Launcher gefunden — sonst waere der
                             Button ins Leere klickend. -->
                        <Button Classes="accent"
                                Content="{loc:Tr Mod_LaunchGame}"
                                Command="{Binding LaunchGameCommand}"
                                IsVisible="{Binding CanLaunchGame}"
                                HorizontalAlignment="Center"
                                ToolTip.Tip="{loc:Tr Mod_LaunchGame_Tip}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</views:ChromeWindow>
