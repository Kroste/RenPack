<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:RenPack.Views"
        xmlns:controls="using:RenPack.Controls"
        xmlns:vm="using:RenPack.ViewModels"
        xmlns:loc="using:RenPack.Localization"
        mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="680"
        x:Class="RenPack.Views.ModGeneratorWindow"
        x:DataType="vm:ModGeneratorViewModel"
        Width="820" Height="720" MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Tr Window_ModGenerator}"
        Background="{DynamicResource KrosteBackgroundBrush}">

    <Design.DataContext>
        <vm:ModGeneratorViewModel />
    </Design.DataContext>

    <DockPanel>
        <controls:TitleBar DockPanel.Dock="Top" Title="{loc:Tr Window_ModGenerator}" />

        <!-- Statusbar -->
        <Border DockPanel.Dock="Bottom" Padding="18,10"
                BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="0,1,0,0"
                Background="{DynamicResource KrosteTitleBarBrush}">
            <TextBlock Text="{Binding StatusText}" Classes="secondary"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Border>

        <ScrollViewer>
            <StackPanel Margin="24" Spacing="16">

                <!-- Header -->
                <StackPanel>
                    <TextBlock Text="{loc:Tr Window_ModGenerator}" Classes="h1" />
                    <TextBlock Text="{loc:Tr Mod_Subtitle}" Classes="muted" FontSize="12"
                               Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Schritt 1: Quelle -->
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{loc:Tr Mod_Section_Source}" Classes="section-label" />
                        <TextBlock Text="{loc:Tr Mod_Source_Description}" Classes="muted"
                                   FontSize="11" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0" Text="{Binding SourceDirectory}"
                                     PlaceholderText="{loc:Tr Mod_Source_Placeholder}" />
                            <Button Grid.Column="1" Content="{loc:Tr Mod_Pick}"
                                    Command="{Binding PickSourceCommand}" />
                        </Grid>
                        <Button Classes="accent" Content="{loc:Tr Mod_Analyze}"
                                Command="{Binding AnalyzeCommand}"
                                HorizontalAlignment="Left" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Schritt 2: Analyse-Ergebnis -->
                <Border Classes="card" IsVisible="{Binding HasAnalysis}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{loc:Tr Mod_Section_Analysis}" Classes="section-label" />
                        <UniformGrid Columns="4" Rows="1">
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding AnalyzedFilesCount}" Classes="h2" HorizontalAlignment="Center" />
                                <TextBlock Text="{loc:Tr Mod_Stat_Files}" Classes="muted" FontSize="11" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding ChoiceCount}" Classes="h2" HorizontalAlignment="Center" />
                                <TextBlock Text="{loc:Tr Mod_Stat_Choices}" Classes="muted" FontSize="11" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding StoreVarCount}" Classes="h2" HorizontalAlignment="Center" />
                                <TextBlock Text="{loc:Tr Mod_Stat_StoreVars}" Classes="muted" FontSize="11" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding CharacterCount}" Classes="h2" HorizontalAlignment="Center" />
                                <TextBlock Text="{loc:Tr Mod_Stat_Characters}" Classes="muted" FontSize="11" HorizontalAlignment="Center" />
                            </StackPanel>
                        </UniformGrid>
                        <Rectangle Classes="divider-h" Margin="0,6,0,0" />
                        <TextBlock Text="{loc:Tr Mod_TopStats_Title}" Classes="secondary" FontSize="11" />
                        <ItemsControl ItemsSource="{Binding TopStats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StatCandidate">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                        <TextBlock Grid.Column="0" Text="{Binding Variable}"
                                                   FontFamily="Cascadia Mono,Consolas,monospace" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ChangeCount, StringFormat='{}{0}×'}"
                                                   Foreground="{DynamicResource KrosteGoldBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Schritt 3: Mod-Typ + Ziel + Generieren -->
                <Border Classes="card" IsVisible="{Binding HasAnalysis}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{loc:Tr Mod_Section_Generate}" Classes="section-label" />

                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Tr Mod_Type}" Classes="secondary" />
                            <ComboBox ItemsSource="{Binding AvailableModTypes}"
                                      SelectedItem="{Binding SelectedModType}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Tr Mod_Destination}" Classes="secondary" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" Text="{Binding DestinationDirectory}"
                                         PlaceholderText="{loc:Tr Mod_Destination_Placeholder}" />
                                <Button Grid.Column="1" Content="{loc:Tr Mod_Pick}"
                                        Command="{Binding PickDestinationCommand}" />
                            </Grid>
                        </StackPanel>

                        <Button Classes="accent" Content="{loc:Tr Mod_Generate}"
                                Command="{Binding GenerateCommand}"
                                HorizontalAlignment="Left" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</views:ChromeWindow>
