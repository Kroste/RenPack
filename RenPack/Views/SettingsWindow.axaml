<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:RenPack.Views"
        xmlns:controls="using:RenPack.Controls"
        xmlns:vm="using:RenPack.ViewModels"
        xmlns:svc="using:RenPack.Services"
        xmlns:loc="using:RenPack.Localization"
        mc:Ignorable="d" d:DesignWidth="680" d:DesignHeight="760"
        x:Class="RenPack.Views.SettingsWindow"
        x:DataType="vm:SettingsWindowViewModel"
        Width="680" Height="800" MinWidth="560" MinHeight="500"
        Title="{loc:Tr Window_Settings}"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource KrosteBackgroundBrush}">

    <Design.DataContext>
        <vm:SettingsWindowViewModel />
    </Design.DataContext>

    <DockPanel>
        <controls:TitleBar DockPanel.Dock="Top" Title="{loc:Tr Window_Settings}" />

        <Border DockPanel.Dock="Bottom" Padding="18,12"
                BorderBrush="{DynamicResource KrosteBorderBrush}" BorderThickness="0,1,0,0"
                Background="{DynamicResource KrosteTitleBarBrush}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                           Foreground="{DynamicResource KrosteGoldBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Classes="ghost" Content="{loc:Tr Settings_TestConnection}"
                        Command="{Binding TestConnectionCommand}" />
                <Button Grid.Column="2" Content="{loc:Tr Settings_Cancel}"
                        Command="{Binding CancelCommand}" />
                <Button Grid.Column="3" Classes="accent" Content="{loc:Tr Settings_Save}"
                        Command="{Binding SaveCommand}" />
            </Grid>
        </Border>

        <ScrollViewer>
            <StackPanel Margin="24" Spacing="18">

                <StackPanel>
                    <TextBlock Text="{loc:Tr Window_Settings}" Classes="h1" />
                    <TextBlock Classes="muted" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="{loc:Tr Settings_Subtitle}" />
                </StackPanel>

                <!-- UI-Sprache (neu, ganz oben — der Nutzer soll die App
                     zuerst in seine Sprache umschalten koennen). -->
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{loc:Tr Settings_Section_UiLanguage}" Classes="section-label" />
                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Tr Settings_UiLanguage}" Classes="secondary" />
                            <ComboBox ItemsSource="{Binding SupportedUiCultures}"
                                      SelectedItem="{Binding SelectedUiCulture}"
                                      DisplayMemberBinding="{Binding Display}"
                                      HorizontalAlignment="Stretch" />
                            <TextBlock Text="{loc:Tr Settings_UiLanguage_Hint}"
                                       Classes="muted" FontSize="11" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Anbieter + Zielsprache (fuer die KI-Uebersetzung) -->
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{loc:Tr Settings_Section_General}" Classes="section-label" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="{loc:Tr Settings_Provider}" Classes="secondary" />
                                <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="{loc:Tr Settings_TargetLanguage}" Classes="secondary" />
                                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding TargetLanguage}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card" IsVisible="{Binding IsOllama}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{loc:Tr Settings_Ollama_Section}" Classes="section-label" />
                        <TextBlock Text="{loc:Tr Settings_Ollama_Title}" Classes="h2" />
                        <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                                   Text="{loc:Tr Settings_Ollama_Description}" />

                        <TextBlock Text="{loc:Tr Settings_Endpoint}" Classes="secondary" Margin="0,6,0,0" />
                        <TextBox Text="{Binding OllamaEndpoint}" PlaceholderText="http://localhost:11434" />

                        <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                            <TextBlock Grid.Column="0" Text="{loc:Tr Settings_Ollama_InstalledModel}"
                                       Classes="secondary" VerticalAlignment="Bottom" />
                            <Button Grid.Column="1" Classes="ghost" Content="{loc:Tr Settings_Ollama_Refresh}" Padding="10,4"
                                    Command="{Binding RefreshOllamaModelsCommand}" />
                        </Grid>
                        <ComboBox ItemsSource="{Binding AvailableOllamaModels}"
                                  SelectedItem="{Binding SelectedInstalledOllamaModel}"
                                  PlaceholderText="{loc:Tr Settings_Ollama_InstalledPlaceholder}"
                                  HorizontalAlignment="Stretch" />
                        <TextBlock Text="{loc:Tr Settings_ModelManualHint}" Classes="muted"
                                   FontSize="11" Margin="0,6,0,0" />
                        <TextBox Text="{Binding OllamaModel}" PlaceholderText="z. B. gemma3:1b" />

                        <TextBlock Text="{loc:Tr Settings_Ollama_Download}" Classes="h2" Margin="0,14,0,0" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding CuratedOllamaModels}"
                                      SelectedItem="{Binding SelectedRecommendedModel}"
                                      PlaceholderText="{loc:Tr Settings_Ollama_DownloadPlaceholder}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="svc:OllamaCuratedModel">
                                        <Grid ColumnDefinitions="150,80,*" Margin="2,4">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource KrosteGoldBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding ApproxSize}"
                                                       Classes="muted" FontSize="11"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Description}"
                                                       Classes="secondary" FontSize="11"
                                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Classes="accent" Content="{loc:Tr Settings_Ollama_DownloadButton}"
                                    Command="{Binding PullRecommendedModelCommand}"
                                    IsEnabled="{Binding SelectedRecommendedModel, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </Grid>
                        <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                                   Text="{loc:Tr Settings_Ollama_DownloadHint}" />
                    </StackPanel>
                </Border>

                <Border Classes="card" IsVisible="{Binding IsAnthropic}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{loc:Tr Settings_Anthropic_Section}" Classes="section-label" />
                        <TextBlock Text="{loc:Tr Settings_Anthropic_Title}" Classes="h2" />
                        <TextBlock Text="{loc:Tr Settings_ApiKey}" Classes="secondary" Margin="0,6,0,0" />
                        <TextBox Text="{Binding AnthropicApiKey}" PasswordChar="•"
                                 PlaceholderText="sk-ant-…" />
                        <TextBlock Text="{loc:Tr Settings_Model}" Classes="secondary" Margin="0,6,0,0" />
                        <ComboBox ItemsSource="{Binding AnthropicModels}"
                                  SelectedItem="{Binding SelectedAnthropicModel}"
                                  PlaceholderText="{loc:Tr Settings_ModelPlaceholder}"
                                  HorizontalAlignment="Stretch" />
                        <TextBlock Text="{loc:Tr Settings_ModelManualHint}" Classes="muted"
                                   FontSize="11" Margin="0,4,0,0" />
                        <TextBox Text="{Binding AnthropicModel}" PlaceholderText="claude-…" />
                        <TextBlock Text="{loc:Tr Settings_EndpointProxyHint}" Classes="muted"
                                   FontSize="11" Margin="0,6,0,0" />
                        <TextBox Text="{Binding AnthropicEndpoint}"
                                 PlaceholderText="https://api.anthropic.com/v1" />
                    </StackPanel>
                </Border>

                <Border Classes="card" IsVisible="{Binding IsOpenAi}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{loc:Tr Settings_OpenAi_Section}" Classes="section-label" />
                        <TextBlock Text="{loc:Tr Settings_OpenAi_Title}" Classes="h2" />
                        <TextBlock Text="{loc:Tr Settings_ApiKey}" Classes="secondary" Margin="0,6,0,0" />
                        <TextBox Text="{Binding OpenAiApiKey}" PasswordChar="•"
                                 PlaceholderText="sk-…" />
                        <TextBlock Text="{loc:Tr Settings_Model}" Classes="secondary" Margin="0,6,0,0" />
                        <ComboBox ItemsSource="{Binding OpenAiModels}"
                                  SelectedItem="{Binding SelectedOpenAiModel}"
                                  PlaceholderText="{loc:Tr Settings_ModelPlaceholder}"
                                  HorizontalAlignment="Stretch" />
                        <TextBlock Text="{loc:Tr Settings_ModelManualHint}" Classes="muted"
                                   FontSize="11" Margin="0,4,0,0" />
                        <TextBox Text="{Binding OpenAiModel}" PlaceholderText="gpt-…" />
                        <TextBlock Text="{loc:Tr Settings_Endpoint}" Classes="muted" FontSize="11" Margin="0,6,0,0" />
                        <TextBox Text="{Binding OpenAiEndpoint}"
                                 PlaceholderText="https://api.openai.com/v1" />
                    </StackPanel>
                </Border>

                <Border Classes="card" IsVisible="{Binding IsGemini}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{loc:Tr Settings_Gemini_Section}" Classes="section-label" />
                        <TextBlock Text="{loc:Tr Settings_Gemini_Title}" Classes="h2" />
                        <TextBlock Text="{loc:Tr Settings_ApiKey}" Classes="secondary" Margin="0,6,0,0" />
                        <TextBox Text="{Binding GeminiApiKey}" PasswordChar="•"
                                 PlaceholderText="AIza…" />
                        <TextBlock Text="{loc:Tr Settings_Model}" Classes="secondary" Margin="0,6,0,0" />
                        <ComboBox ItemsSource="{Binding GeminiModels}"
                                  SelectedItem="{Binding SelectedGeminiModel}"
                                  PlaceholderText="{loc:Tr Settings_ModelPlaceholder}"
                                  HorizontalAlignment="Stretch" />
                        <TextBlock Text="{loc:Tr Settings_ModelManualHint}" Classes="muted"
                                   FontSize="11" Margin="0,4,0,0" />
                        <TextBox Text="{Binding GeminiModel}" PlaceholderText="gemini-…" />
                        <TextBlock Text="{loc:Tr Settings_Endpoint}" Classes="muted" FontSize="11" Margin="0,6,0,0" />
                        <TextBox Text="{Binding GeminiEndpoint}"
                                 PlaceholderText="https://generativelanguage.googleapis.com/v1beta" />
                    </StackPanel>
                </Border>

                <Border Classes="card" IsVisible="{Binding IsMistral}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{loc:Tr Settings_Mistral_Section}" Classes="section-label" />
                        <TextBlock Text="{loc:Tr Settings_Mistral_Title}" Classes="h2" />
                        <TextBlock Text="{loc:Tr Settings_ApiKey}" Classes="secondary" Margin="0,6,0,0" />
                        <TextBox Text="{Binding MistralApiKey}" PasswordChar="•"
                                 PlaceholderText="…" />
                        <TextBlock Text="{loc:Tr Settings_Model}" Classes="secondary" Margin="0,6,0,0" />
                        <ComboBox ItemsSource="{Binding MistralModels}"
                                  SelectedItem="{Binding SelectedMistralModel}"
                                  PlaceholderText="{loc:Tr Settings_ModelPlaceholder}"
                                  HorizontalAlignment="Stretch" />
                        <TextBlock Text="{loc:Tr Settings_ModelManualHint}" Classes="muted"
                                   FontSize="11" Margin="0,4,0,0" />
                        <TextBox Text="{Binding MistralModel}" PlaceholderText="mistral-…" />
                        <TextBlock Text="{loc:Tr Settings_Endpoint}" Classes="muted" FontSize="11" Margin="0,6,0,0" />
                        <TextBox Text="{Binding MistralEndpoint}"
                                 PlaceholderText="https://api.mistral.ai/v1" />
                    </StackPanel>
                </Border>

                <Border Classes="card" IsVisible="{Binding IsOpenAiCompatible}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{loc:Tr Settings_Compatible_Section}" Classes="section-label" />
                        <TextBlock Text="{loc:Tr Settings_Compatible_Title}" Classes="h2" />
                        <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                                   Text="{loc:Tr Settings_Compatible_Description}" />
                        <TextBlock Text="{loc:Tr Settings_Compatible_BaseUrl}" Classes="secondary" Margin="0,6,0,0" />
                        <TextBox Text="{Binding OpenAiCompatibleEndpoint}"
                                 PlaceholderText="http://localhost:8080/v1" />
                        <TextBlock Text="{loc:Tr Settings_Model}" Classes="secondary" Margin="0,6,0,0" />
                        <TextBox Text="{Binding OpenAiCompatibleModel}"
                                 PlaceholderText="z. B. mixtral-8x7b, deepseek-r1, …" />
                        <TextBlock Text="{loc:Tr Settings_Compatible_ApiKeyOptional}" Classes="secondary"
                                   Margin="0,6,0,0" />
                        <TextBox Text="{Binding OpenAiCompatibleApiKey}" PasswordChar="•" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</views:ChromeWindow>
