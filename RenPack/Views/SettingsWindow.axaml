<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:RenPack.Views"
        xmlns:controls="using:RenPack.Controls"
        xmlns:vm="using:RenPack.ViewModels"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="480"
        x:Class="RenPack.Views.SettingsWindow"
        x:DataType="vm:SettingsWindowViewModel"
        Width="520" Height="490" MinWidth="440" MinHeight="360"
        Title="RenPack — Einstellungen"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource KrosteBackgroundBrush}">

    <Design.DataContext>
        <vm:SettingsWindowViewModel />
    </Design.DataContext>

    <DockPanel>
        <controls:TitleBar DockPanel.Dock="Top" Title="RenPack — Einstellungen" />

        <!-- Buttons unten -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource KrosteTitleBarBrush}" Padding="12,10">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                           Foreground="{DynamicResource KrosteGoldBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Content="Abbrechen" Margin="0,0,8,0"
                        Command="{Binding CancelCommand}" />
                <Button Grid.Column="2" Classes="accent" Content="Speichern"
                        Command="{Binding SaveCommand}" />
            </Grid>
        </Border>

        <StackPanel Margin="20" Spacing="14">
            <TextBlock Text="KI-Übersetzung" FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource KrosteGoldBrush}" />
            <TextBlock Foreground="#B7BEC7" TextWrapping="Wrap"
                       Text="Übersetzt die Variablennamen im Save-Editor in eine
                       verständliche Beschreibung. Die Namen selbst bleiben
                       unverändert (sie sind der Splice-Anker beim Speichern)." />

            <StackPanel Spacing="6">
                <TextBlock Text="Anbieter" Foreground="#B7BEC7" />
                <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}"
                          HorizontalAlignment="Stretch" />
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding IsOllama}">
                <TextBlock Text="Ollama-Endpunkt" Foreground="#B7BEC7" />
                <TextBox Text="{Binding OllamaEndpoint}" PlaceholderText="http://localhost:11434" />

                <TextBlock Text="Modell" Foreground="#B7BEC7" Margin="0,6,0,0" />
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <AutoCompleteBox Grid.Column="0" Text="{Binding OllamaModel, Mode=TwoWay}"
                                     ItemsSource="{Binding AvailableModels}" />
                    <Button Grid.Column="1" Content="Modelle laden" Margin="8,0,0,0"
                            Command="{Binding RefreshModelsCommand}" />
                    <Button Grid.Column="2" Content="Verbindung testen" Margin="8,0,0,0"
                            Command="{Binding TestConnectionCommand}" />
                </Grid>
                <TextBlock Foreground="#8A93A0" FontSize="11" TextWrapping="Wrap"
                           Text="Vorschlag: gemma3:1b (schnell, klein) oder qwen2.5:3b (bessere Qualität).
                           Modelle vorher im Terminal ziehen: ollama pull gemma3:1b" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Zielsprache" Foreground="#B7BEC7" />
                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding TargetLanguage}"
                          HorizontalAlignment="Stretch" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</views:ChromeWindow>
