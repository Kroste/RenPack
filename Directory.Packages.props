<Project>
  <!-- Central Package Management: EINZIGER Ort für Paketversionen.
       Versionen mit CHECK-Kommentar beim Projektstart gegen NuGet prüfen! -->
  <ItemGroup>
    <!-- Avalonia — CHECK: neueste stabile 12.x.
         DiagnosticsSupport folgt NICHT der Avalonia-Version (eigene 2.x-Reihe)! -->
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.1.0" />
    <!-- Nur Debug-Builds referenzieren dieses Paket (DevTools) -->
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <!-- Pinnen passend zur Avalonia-Version (Linux DBus/Tray) — CHECK -->
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.94.2" />

    <!-- MVVM & DI — CHECK: aktuelle Versionen -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <!-- DPAPI unter Windows (auf Linux ist der Namespace via Fallback in
         SecretProtection ohnehin nicht aktiv, aber das Paket muss referenziert
         sein, damit der Compiler auf allen Plattformen die Symbole kennt). -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="9.0.10" />

    <!-- Logging — CHECK -->
    <PackageVersion Include="NLog" Version="6.1.4" />

    <!-- Python-Pickle lesen/schreiben (Ren'Py-Index). MIT-Lizenz. -->
    <PackageVersion Include="Razorvine.Pickle" Version="1.5.0" />

    <!-- Media-Preview: kein LibVLC (deployment-Chaos, Airspace-Probleme
         im UI, siehe Spektiv-Kommentar zum selben Trade-off). Stattdessen
         ffmpeg als externer Subprocess fuer Standbild-Frame-Grab, und
         Process.Start(useShellExecute) fuer echtes Playback im System-
         Default-Player. Kein NuGet noetig. -->

    <!-- Versionierung -->
    <PackageVersion Include="MinVer" Version="7.0.0" />

    <!-- Tests — CHECK (xunit.v3, NICHT das alte "xunit"-Paket — v2 ist deprecated);
         FluentAssertions NICHT auf 8.x heben (Xceed-Lizenz) -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="FluentAssertions" Version="[7.2.2,8.0.0)" />

    <!-- Headless-UI-Tests: manuelles Avalonia.Headless-Setup, KEIN
         Avalonia.Headless.XUnit-Wrapper (der ist an xunit v2 gebunden;
         xunit.v3 hat andere Test-Framework-Signaturen). -->
    <PackageVersion Include="Avalonia.Headless" Version="12.1.0" />
  </ItemGroup>
</Project>
